# ===================================
# etf-dashboard Docker Compose 环境变量模板
# ===================================
# 复制为 .env 并填写令牌：
#   cp .env.example .env
#
# 值来源：宿主 ~/.claude/settings.json 的 env 块（claude -p 认证走方舟 ARK）。
# ANTHROPIC_AUTH_TOKEN 是敏感凭据，仅写入本地 .env（已被 .gitignore 排除），勿提交。

# ── claude -p 认证（可选：仅当 DASHBOARD_SCHEDULER_ENGINE=claude 兜底时才需要）──
# 默认引擎 auto：容器内已装 dsh → 走 dsh（读 DEEPSEEK_API_KEY），无需此令牌。
# 值来源：宿主 ~/.claude/settings.json 的 env 块（方舟 ARK）。
ANTHROPIC_AUTH_TOKEN=

# ── 方舟 ARK 端点与模型路由（默认即宿主值，一般无需改）──
ANTHROPIC_BASE_URL=https://ark.cn-beijing.volces.com/api/plan
ANTHROPIC_MODEL=deepseek-v4-flash-ga-260731
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-pro[1m]
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-flash[1m]
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-flash[1m]
API_TIMEOUT_MS=3000000
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash[1m]

# ── 调度开关：1=引擎随 Web/容器启停（默认，无需系统 cron/计划任务）；
#    0=关闭引擎 auto（外部 cron 精确触发场景，见 DEPLOY.md §5.1）──
DASHBOARD_SCHEDULER_ENABLED=1

# ── 执行引擎：auto|dsh|claude（默认 auto = 本地探测到 dsh 则用 dsh，否则 claude）。
#    容器内未装 dsh → 自动落到 claude -p（需 ANTHROPIC_AUTH_TOKEN）──
DASHBOARD_SCHEDULER_ENGINE=auto

# ── 调度窗口容差（分钟，可选）：默认 7（task_schedule.json 的 window_minutes）。
#    夜间休眠恢复错过窗口的场景可设 30 放宽（与旧 dsh_trigger ±3h 语义对齐）──
# DASHBOARD_SCHEDULER_WINDOW_MINUTES=30

# ── 可选 ──
# DASHBOARD_PORT=8000
# DASHBOARD_ADMIN_PASSWORD=
# DASHBOARD_SECRET_KEY=

# ── 拟人 Agent「小满」的 LLM 凭据 ──
# 本地跑：key 由 dsh 统一管理（~/.dsh/.credentials.yaml 的 DEEPSEEK_API_KEY），
#         此处无需配置——key 单点。
# Docker 跑：compose 把本变量注入 agent 容器，供容器内 dsh 使用（同样只配这一处）。
# 获取：https://platform.deepseek.com → API Keys
DEEPSEEK_API_KEY=

# ── 云端权威数据库（火山 Supabase 版 Postgres，PostgREST Data API）──
# DASHBOARD_DB_BACKEND=cloud     # dashboard 权威表走云库（本地仅留 kline/nav 缓存）
# AGENT_DB_BACKEND=cloud         # agent 权威数据走云库
# SUPABASE_URL=                  # 项目 PostgREST 端点
# SUPABASE_SERVICE_KEY=          # service_role key
# 取值方式：byted-supabase-cli endpoints list + projects api-keys（见 docs/2026-09-07-云端数据库迁移方案.md）
# 注：2026-09-07 已移除 TOS 对象存储（DB_MODE=memory / CLOUD_RESTORE_ON_START / cloud.json）。
