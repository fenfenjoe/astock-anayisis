# Python
__pycache__/
*.py[cod]
*.pyo
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Data cache (parquet files are fetched on demand)
etf-strategies/cache/*.parquet
etf-strategies/cache/etf_names.json

# Generated reports & charts (reproducible via CLI)
etf-strategies/report/*.html

# Temporary scripts
_*.py

# Secrets（.env 内含 ANTHROPIC_AUTH_TOKEN 等，勿提交）
.env
.env.local
.env.*
!.env.example

# 企业微信通知凭证（corpid/agentid/secret/touser，勿提交）
etf-strategies/dashboard/data/notify_config.json

# OS
.DS_Store
Thumbs.db

# JWT secret (auto-generated by dashboard, never commit)
etf-strategies/dashboard/data/.secret_key

# 2026-10-15 解耦：agent 运行时/技能/调度已全部外迁至 ~/.dsh/workspace/xiaoman/，
# 仓库不再包含 .dsh / .agents / agent 运行时，以下旧忽略规则已移除。

# Runtime data (OpenViking local store / dashboard cache)
data/
etf-strategies/dashboard/data/cache.db

# Cloud sync config & runtime (secrets / snapshots / logs)
scripts/config/cloud.json
scripts/.snapshots/
scripts/logs/cloud_sync.log
scripts/logs/

# _*.py 一次性取数脚本（合法入口 __main__.py / __init__.py 除外）
!**/__main__.py
!**/__init__.py

.npm-cache
node_modules